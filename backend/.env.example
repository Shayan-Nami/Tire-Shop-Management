# Copy to backend/.env and review every value before deploying.
# Real process environment variables take precedence over this file.

# --- Core ---------------------------------------------------------------
# Required when DJANGO_DEBUG=False (startup fails without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# With DJANGO_DEBUG=True and no key, a random per-process key is generated
# (sessions/tokens are invalidated on every restart). Keys starting with
# "django-insecure-" are rejected when DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_DEMO_SEED=False

# Expose /api/docs, /api/redoc and /api/schema to everyone outside DEBUG.
# Default False: only managers/superusers may open them. Normally leave off.
ENABLE_DOCS_IN_PROD=False

# --- Browser origins ----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Origins (with scheme) allowed to submit CSRF-protected session requests,
# e.g. Django admin behind a different public hostname. Default: the same
# local development origins as above.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Database -----------------------------------------------------------
# sqlite (default), postgres, or mssql. Unknown values silently fall back to SQLite.
DB_ENGINE=sqlite
DB_NAME=tire_shop_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Persistent connection lifetime in seconds (0 = close after every request).
CONN_MAX_AGE=60

# SQL Server only (requires `pip install -r requirements-mssql.txt` and a native ODBC driver).
DB_DRIVER=ODBC Driver 17 for SQL Server
USE_SQL_SERVER=False
# Defaults to true when DB_USER is empty, false otherwise.
# DB_TRUSTED_CONNECTION=
# Transport encryption (default yes) and certificate-validation bypass (default no).
# Prefer installing a trusted certificate over setting DB_TRUST_SERVER_CERTIFICATE=yes.
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=no

# --- Throttling and caching ---------------------------------------------
# Number of trusted reverse-proxy hops in front of Django. Must match the real chain:
# behind one proxy use 1, otherwise every client shares one login-throttle bucket.
NUM_PROXIES=0
# Shared cache for throttle counters. Without it each gunicorn worker keeps its own
# counters (LocMem), multiplying the effective limits.
REDIS_CACHE_URL=
THROTTLE_ANON_RATE=30/minute
THROTTLE_USER_RATE=300/minute
# Also applied to POST /admin/login/ (separate counters from the API login).
THROTTLE_LOGIN_IP_RATE=5/minute
THROTTLE_LOGIN_USER_RATE=5/minute
THROTTLE_TOKEN_REFRESH_RATE=15/minute
# Not used to change the default page size (fixed at 20); clients send ?page_size= (max 100).
# PAGINATION_PAGE_SIZE=20

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# --- HTTPS / cookies ----------------------------------------------------
# Trust X-Forwarded-Proto from the reverse proxy. Enable only when the proxy
# always sets/overwrites it, and set NUM_PROXIES accordingly.
SECURE_PROXY_SSL_HEADER=False

# Session/CSRF cookies are Secure by default when DJANGO_DEBUG=False, so the Django
# admin only works over HTTPS (or localhost). Deployments that serve the admin over
# plain HTTP on a LAN must opt out explicitly:
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# (The SPA authenticates with JWT headers and is not affected by these two.)

# HTTPS redirect and HSTS stay opt-in because many shops run on a plain-HTTP LAN.
# Enable SECURE_SSL_REDIRECT once all traffic is HTTPS. HSTS is effectively
# irreversible for the browsers that saw it: turn it on only after HTTPS works for
# every hostname, start small (e.g. 3600), and raise gradually (31536000 = 1 year).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
