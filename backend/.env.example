# ==============================================================================
# نمونه فایل متغیرهای محیطی پروژه سامانه مدیریت فروشگاه لاستیک (Tire Shop)
# فایل اصلی (.env) نباید تحت هیچ شرایطی به مخزن گیت اضافه (commit) شود.
# ==============================================================================

# --- تنظیمات امنیتی هسته جنگو ---
# هشدار: در محیط پروداکشن (DEBUG=False)، حتماً یک کلید امن، طولانی و تصادفی اختصاص دهید.
# تولید کلید در پایتون: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- تنظیمات CORS برای فرانت‌اند وب و اپلیکیشن موبایل ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- پایگاه داده (پشتیبانی چندگانه: sqlite / postgres / mssql) ---
# موتورهای مجاز: sqlite (پیش‌فرض) | postgres | mssql
DB_ENGINE=sqlite
DB_NAME=tire_shop_db
DB_USER=postgres
DB_PASSWORD=
# نکته مهم: در محیط‌های ویندوزی حتماً از 127.0.0.1 به جای localhost استفاده فرمایید تا از تاخیرهای تفکیک DNS (حدود ۱۳۰ ثانیه) جلوگیری شود.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DRIVER=SQL Server
USE_SQL_SERVER=False

# --- تنظیمات پروکسی و کش نرخ درخواست (Throttling & Shared Cache) ---
# پیش‌فرض 0 است (تنها به REMOTE_ADDR اتکا می‌کند و هدرهای جعلی X-Forwarded-For را نادیده می‌گیرد).
# اگر برنامه پشت یک وب‌سرور معکوس مانند Nginx قرار دارد، مقدار را به 1 تغییر دهید:
NUM_PROXIES=0
# آدرس کش مشترک توزیع‌شده (مانند Redis) جهت اعمال سقف درخواست‌ها در محیط‌های چند-پروسسی (Gunicorn Workers):
# نمونه: REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=
THROTTLE_ANON_RATE=30/minute
THROTTLE_USER_RATE=300/minute
THROTTLE_LOGIN_IP_RATE=5/minute
THROTTLE_LOGIN_USER_RATE=5/minute
THROTTLE_TOKEN_REFRESH_RATE=15/minute

# --- طول عمر توکن‌های JWT (برحسب دقیقه و روز) ---
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=14

# --- تنظیمات پروتکل امن HTTPS و هدرهای امنیتی پروداکشن ---
SECURE_PROXY_SSL_HEADER=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
